    });
%}


### ------------------------------------------------------------
# FIX 2 - UpdateExam saves UTC dates
# A date WITH an offset (or no zone) is parsed by .NET as Local/Unspecified.
# Npgsql refuses to write that to timestamptz, so before the fix these gave 500.
# ------------------------------------------------------------

### 2.1 Update with a +05:45 offset (Nepal time)
# 09:00 at +05:45 = 03:15 UTC.
# EXPECT 200, startDate "2026-12-05T03:15:00Z", endDate "2026-12-06T03:15:00Z"
PUT {{host}}/api/exam/{{fixExamId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "FixExam{{sfx}}",
  "examType": "Midterm",
  "startDate": "2026-12-05T09:00:00+05:45",
  "endDate": "2026-12-06T09:00:00+05:45",
  "schoolClassId": {{fixClassId}}
}

> {%
    client.test("2.1 offset date -> 200 and converted to UTC", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.startDate.startsWith("2026-12-05T03:15:00"), "startDate: " + response.body.data.startDate);
        client.assert(response.body.data.endDate.startsWith("2026-12-06T03:15:00"), "endDate: " + response.body.data.endDate);
    });
%}

### 2.2 Read it back from the database
# EXPECT 200, our exam has the same UTC start as 2.1 (proves it was SAVED as UTC)
GET {{host}}/api/exam
Authorization: Bearer {{adminToken}}

> {%
    const list = Array.isArray(response.body) ? response.body : response.body.data;
    const exam = list.find(x => x.id === client.global.get("fixExamId"));
    client.test("2.2 saved value is UTC", function () {
        client.assert(exam !== undefined, "exam not in list");
        client.assert(exam.startDate.startsWith("2026-12-05T03:15:00"), "startDate: " + exam.startDate);
        client.assert(exam.endDate.startsWith("2026-12-06T03:15:00"), "endDate: " + exam.endDate);
    });
%}

### 2.3 Update with NO zone at all
# Treated as the server's local time. The exact value depends on your Mac's time zone,
# so we only check: EXPECT 200 and the dates come back ending in Z.
PUT {{host}}/api/exam/{{fixExamId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "FixExam{{sfx}}",
  "examType": "Midterm",
  "startDate": "2026-12-07T09:00:00",
  "endDate": "2026-12-08T09:00:00",
  "schoolClassId": {{fixClassId}}
}

> {%
    client.test("2.3 no-zone date -> 200, UTC (ends in Z)", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.startDate.endsWith("Z"), "startDate: " + response.body.data.startDate);
        client.assert(response.body.data.endDate.endsWith("Z"), "endDate: " + response.body.data.endDate);
    });
%}

### 2.4 Update with Z (regression, the way the frontend should send it)
# EXPECT 200, startDate exactly "2026-12-09T09:00:00Z"
PUT {{host}}/api/exam/{{fixExamId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "FixExam{{sfx}}",
  "examType": "Midterm",
  "startDate": "2026-12-09T09:00:00Z",
  "endDate": "2026-12-10T09:00:00Z",
  "schoolClassId": {{fixClassId}}
}

> {%
    client.test("2.4 Z date unchanged", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.startDate === "2026-12-09T09:00:00Z", "startDate: " + response.body.data.startDate);
        client.assert(response.body.data.endDate === "2026-12-10T09:00:00Z", "endDate: " + response.body.data.endDate);
    });
%}

### 2.5 End date before start date (validation still works)
# EXPECT 400, "End date cannot be before the start date"
PUT {{host}}/api/exam/{{fixExamId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "FixExam{{sfx}}",
  "examType": "Midterm",
  "startDate": "2026-12-10T09:00:00Z",
  "endDate": "2026-12-09T09:00:00Z",
  "schoolClassId": {{fixClassId}}
}

> {%
    client.test("2.5 end before start -> 400", function () {
        client.assert(response.status === 400, "status " + response.status);
    });
%}


### ------------------------------------------------------------
# FIX 3 - control only (the real test is fix3-race.sh)
# ------------------------------------------------------------

### 3.1 Same mark entered twice, one after the other
# EXPECT 400, "Mark already exists for this student and subject".
# This is caught by the handler's own check, NOT by the database, so it is a 400.
# The 409 only appears when two requests collide at the same instant (see fix3-race.sh).
POST {{host}}/api/teacher/exams/{{fixExamId}}/marks
Authorization: Bearer {{fixTeacherToken}}
Content-Type: application/json

{
  "studentId": {{fixStudentId}},
  "subjectId": {{fixSubjectId}},
  "marksObtained": 60,
  "maxMarks": 100
}

> {%
    client.test("3.1 duplicate mark -> 400 already exists", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "Mark already exists for this student and subject", "message: " + response.body.message);
    });
%}
