### ------------------------------------------------------------
# FIX 1 - EnterMark: subject null check before IsActive check
# Before the fix, an unknown subject id threw NullReferenceException (500).
# ------------------------------------------------------------

### 1.1 Mark for a subject that does NOT exist
# EXPECT 400, message "Subject not found" (used to be 500)
POST {{host}}/api/teacher/exams/{{fixExamId}}/marks
Authorization: Bearer {{fixTeacherToken}}
Content-Type: application/json

{
  "studentId": {{fixStudentId}},
  "subjectId": 99999,
  "marksObtained": 55,
  "maxMarks": 100
}

> {%
    client.test("1.1 unknown subject -> 400 Subject not found", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "Subject not found", "message: " + response.body.message);
    });
%}

### 1.2a Admin deactivates the subject (EXPECT 200)
PUT {{host}}/api/subject/{{fixSubjectId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("1.2a subject deactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### 1.2b Mark for the now INACTIVE subject
# EXPECT 400, message "Subject is not active" (the inactive check still works)
POST {{host}}/api/teacher/exams/{{fixExamId}}/marks
Authorization: Bearer {{fixTeacherToken}}
Content-Type: application/json

{
  "studentId": {{fixStudentId}},
  "subjectId": {{fixSubjectId}},
  "marksObtained": 55,
  "maxMarks": 100
}

> {%
    client.test("1.2b inactive subject -> 400 Subject is not active", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "Subject is not active", "message: " + response.body.message);
    });
%}

### 1.2c Admin reactivates the subject (EXPECT 200)
PUT {{host}}/api/subject/{{fixSubjectId}}/activate
Authorization: Bearer {{adminToken}}

> {%
    client.test("1.2c subject reactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### 1.3 Normal mark (positive control)
# EXPECT 200, status Draft
POST {{host}}/api/teacher/exams/{{fixExamId}}/marks
Authorization: Bearer {{fixTeacherToken}}
Content-Type: application/json

{
  "studentId": {{fixStudentId}},
  "subjectId": {{fixSubjectId}},
