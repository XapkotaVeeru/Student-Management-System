### ============================================================
# FIX TESTS - covers the 3 fixes (EnterMark null check, UpdateExam UTC dates, DbUpdateExceptionHandler)
# ============================================================
# Put this file in StudentManagement.Web/ next to Section1Tests.http.
# Run top to bottom, one request at a time. Every request has assertions:
# Rider shows PASS/FAIL under "Tests" in the response panel.
#
# Works on ANY database (empty or not): it creates its own class, subject, teacher
# and student, named with a random suffix (set in S1), so it can be re-run.
# Access tokens last 15 minutes. If you get 401, re-run S1 and the matching login.
#
# Fix 3 (409 on unique violation) can only be proven with a real race.
# Run fix3-race.sh for that. Step 3.1 here is only the normal duplicate check.

@host = http://localhost:5280
@adminPassword = Admin@12345
@password = Password123!


### ------------------------------------------------------------
# SETUP
# ------------------------------------------------------------

### S1 Admin login + random suffix (EXPECT 200)
# @name loginAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set("adminToken", response.body.data.accessToken);
    client.global.set("sfx", String(new Date().getTime()).slice(-6));
    client.test("S1 admin logged in", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### S2 Class (EXPECT 200)
POST {{host}}/api/class
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "FixClass{{sfx}}",
  "academicYear": "2026"
}

> {%
    client.global.set("fixClassId", response.body.data.id);
    client.test("S2 class created", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

