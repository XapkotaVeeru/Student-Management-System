### S8 Register student (EXPECT 200). Send ONCE only.
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "ib2student{{sfx}}@test.com",
  "username": "ib2student{{sfx}}",
  "password": "{{password}}"
}

> {%
    client.test("S8 student registered", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### S9 Find the student's user id (EXPECT 200)
GET {{host}}/api/user
Authorization: Bearer {{adminToken}}

> {%
    const name = "ib2student" + client.global.get("sfx");
    const u = response.body.data.find(x => x.username === name);
    client.test("S9 student user found", function () {
        client.assert(u !== undefined, "user " + name + " not in list");
    });
    if (u) { client.global.set("studentUserId", u.id); }
%}

### S10 Approve student into class A (EXPECT 200)
PUT {{host}}/api/user/{{studentUserId}}/approve
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "isApproved": true,
  "firstName": "Ib",
  "lastName": "Student",
  "dateOfBirth": "2010-05-15",
  "gender": 0,
  "phoneNumber": "",
  "address": "Kathmandu",
  "schoolClassId": {{classAId}}
}

> {%
    client.test("S10 student approved", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === true, response.body.message);
    });
%}

