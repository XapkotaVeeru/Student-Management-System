        client.assert(response.status === 200, "status " + response.status);
    });
%}


### ============================================================
# PART A - Items 7, 10, 11: teacher lists and DeactivateClass
# ============================================================

### A1 Teacher lists classes (control)
# EXPECT 200, both class A and class B are listed
GET {{host}}/api/teacher/classes
Authorization: Bearer {{teacherToken}}

> {%
    const a = client.global.get("classAId");
    const b = client.global.get("classBId");
    client.test("A1 both classes listed", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.some(x => x.classId === a), "class A missing");
        client.assert(response.body.some(x => x.classId === b), "class B missing");
    });
%}

### A2 Teacher lists subjects (control)
# EXPECT 200, the subject is listed
GET {{host}}/api/teacher/subjects
Authorization: Bearer {{teacherToken}}

> {%
    const id = client.global.get("subjectId");
    client.test("A2 subject listed", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.some(x => x.subjectId === id), "subject missing");
    });
%}

### A3 Deactivate class A, which still has an ACTIVE student (item 11)
# EXPECT 400, "Cannot deactivate a class that still has active students."
PUT {{host}}/api/class/{{classAId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("A3 class with active students cannot be deactivated", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "Cannot deactivate a class that still has active students.", "message: " + response.body.message);
    });
%}

### A4 Deactivate class B, which is empty (item 11, positive case)
# EXPECT 200, isActive false
PUT {{host}}/api/class/{{classBId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("A4 empty class deactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.data.isActive === false, "isActive still true");
    });
%}

### A5 Teacher lists classes again (item 7)
# EXPECT 200, class A is listed, class B is NOT
GET {{host}}/api/teacher/classes
Authorization: Bearer {{teacherToken}}

> {%
    const a = client.global.get("classAId");
    const b = client.global.get("classBId");
    client.test("A5 inactive class hidden", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.some(x => x.classId === a), "class A missing");
        client.assert(!response.body.some(x => x.classId === b), "inactive class B is still listed");
    });
%}

### A6 Admin deactivates the subject (EXPECT 200)
PUT {{host}}/api/subject/{{subjectId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("A6 subject deactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### A7 Teacher lists subjects again (item 10)
# EXPECT 200, the subject is NOT listed
GET {{host}}/api/teacher/subjects
Authorization: Bearer {{teacherToken}}

> {%
    const id = client.global.get("subjectId");
    client.test("A7 inactive subject hidden", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(!response.body.some(x => x.subjectId === id), "inactive subject is still listed");
    });
%}

### A8 Admin reactivates the subject (EXPECT 200)
PUT {{host}}/api/subject/{{subjectId}}/activate
Authorization: Bearer {{adminToken}}

> {%
    client.test("A8 subject reactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}


### ============================================================
# PART B - Items 8, 13 and Part E: exam activate / deactivate
# ============================================================

### B1 Teacher lists exams (control)
# EXPECT 200, the exam is listed (even though it is not published)
GET {{host}}/api/exam
Authorization: Bearer {{teacherToken}}

> {%
    const id = client.global.get("examId");
    client.test("B1 exam listed for teacher", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.some(x => x.id === id), "exam missing");
    });
%}

### B2 Admin deactivates the exam
# EXPECT 200, "Exam deactivated successfully"
PUT {{host}}/api/exam/{{examId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("B2 exam deactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.message === "Exam deactivated successfully", "message: " + response.body.message);
    });
%}

### B3 Deactivate the same exam again
# EXPECT 400, "Exam is already inactive"
PUT {{host}}/api/exam/{{examId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("B3 double deactivate rejected", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "Exam is already inactive", "message: " + response.body.message);
    });
%}

### B4 Teacher lists exams (item 8)
# EXPECT 200, the inactive exam is NOT listed
GET {{host}}/api/exam
Authorization: Bearer {{teacherToken}}

> {%
    const id = client.global.get("examId");
    client.test("B4 inactive exam hidden from teacher", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(!response.body.some(x => x.id === id), "inactive exam is still listed");
    });
%}

### B5 Admin publishes the INACTIVE exam (item 13)
# EXPECT 400, "Exam is not active"
PUT {{host}}/api/admin/exams/{{examId}}/publish
Authorization: Bearer {{adminToken}}

> {%
    client.test("B5 inactive exam cannot be published", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "Exam is not active", "message: " + response.body.message);
    });
%}

### B6 Admin activates the exam
# EXPECT 200, "Exam activated successfully"
PUT {{host}}/api/exam/{{examId}}/activate
Authorization: Bearer {{adminToken}}

> {%
    client.test("B6 exam activated", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.message === "Exam activated successfully", "message: " + response.body.message);
    });
%}

### B7 Activate the same exam again
# EXPECT 400, "Exam is already active"
PUT {{host}}/api/exam/{{examId}}/activate
Authorization: Bearer {{adminToken}}

> {%
    client.test("B7 double activate rejected", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "Exam is already active", "message: " + response.body.message);
    });
%}

### B8 Teacher lists exams again
# EXPECT 200, the exam is back in the list
GET {{host}}/api/exam
Authorization: Bearer {{teacherToken}}

> {%
    const id = client.global.get("examId");
    client.test("B8 reactivated exam listed again", function () {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.some(x => x.id === id), "exam missing");
    });
%}

### B9 A teacher cannot activate or deactivate exams
# EXPECT 403
PUT {{host}}/api/exam/{{examId}}/deactivate
Authorization: Bearer {{teacherToken}}

> {%
    client.test("B9 teacher gets 403", function () {
        client.assert(response.status === 403, "status " + response.status);
    });
%}


### ============================================================
# PART C - Part F: a deactivated user's token stops working at once
# ============================================================

### C1 Teacher profile with a valid token (control)
# EXPECT 200
GET {{host}}/api/teacher/me
Authorization: Bearer {{teacherToken}}

> {%
    client.test("C1 active teacher token works", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### C2 Admin deactivates the teacher (EXPECT 200)
PUT {{host}}/api/teacher/{{teacherId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("C2 teacher deactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### C3 Same teacher token, seconds later
# EXPECT 401 (the old token is rejected immediately, not after 15 minutes)
GET {{host}}/api/teacher/me
Authorization: Bearer {{teacherToken}}

> {%
    client.test("C3 deactivated teacher token rejected", function () {
        client.assert(response.status === 401, "status " + response.status);
    });
%}

### C4 Deactivated teacher tries to log in
# EXPECT 400, "User is not active"
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "ib2teacher{{sfx}}",
  "password": "{{password}}"
}

> {%
    client.test("C4 login rejected", function () {
        client.assert(response.status === 400, "status " + response.status);
        client.assert(response.body.message === "User is not active", "message: " + response.body.message);
    });
%}

### C5 Admin reactivates the teacher (EXPECT 200)
PUT {{host}}/api/teacher/{{teacherId}}/activate
Authorization: Bearer {{adminToken}}

> {%
    client.test("C5 teacher reactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### C6 The OLD teacher token works again
# EXPECT 200 (the token itself is still valid, only the active check had blocked it)
GET {{host}}/api/teacher/me
Authorization: Bearer {{teacherToken}}

> {%
    client.test("C6 old token works after reactivation", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### C7 Admin deactivates the student (EXPECT 200)
PUT {{host}}/api/student/{{studentId}}/deactivate
Authorization: Bearer {{adminToken}}

> {%
    client.test("C7 student deactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### C8 Student token after deactivation
# EXPECT 401
GET {{host}}/api/student/me
Authorization: Bearer {{studentToken}}

> {%
    client.test("C8 deactivated student token rejected", function () {
        client.assert(response.status === 401, "status " + response.status);
    });
%}

### C9 Admin reactivates the student (EXPECT 200)
PUT {{host}}/api/student/{{studentId}}/activate
Authorization: Bearer {{adminToken}}

> {%
    client.test("C9 student reactivated", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### C10 Student token works again
# EXPECT 200
GET {{host}}/api/student/me
Authorization: Bearer {{studentToken}}

> {%
    client.test("C10 student token works after reactivation", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}
