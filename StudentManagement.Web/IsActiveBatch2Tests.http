### ============================================================
# IS-ACTIVE BATCH 2 TESTS
#   Items 7, 10 : teacher GetMyClasses / GetMySubjects show only ACTIVE classes and subjects
#   Item 11     : DeactivateClass is blocked while the class has active students
#   Item 8      : teacher exam list hides inactive exams
#   Item 13     : an inactive exam cannot be published
#   Part E      : exam activate / deactivate endpoints
#   Part F      : a deactivated user's token is rejected with 401 at once
# ============================================================
# Put this file in StudentManagement.Web/ and run it top to bottom, one request at a time.
# Works on any database: it creates its own classes, subject, teacher and student (suffix from S1).
# Every request has assertions: see PASS/FAIL in the Tests tab of the response panel.
# No manual SQL needed.
#
# 401? DO NOT re-run S1 (new suffix breaks the logins). Re-send R1 (admin), S5 (teacher), S11 (student).
# Send S8 only ONCE.

@host = http://localhost:5280
@adminPassword = Admin@12345
@password = Password123!


### ------------------------------------------------------------
# SETUP
# ------------------------------------------------------------

### S1 Admin login + random suffix (EXPECT 200)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set("adminToken", response.body.data.accessToken);
    client.global.set("sfx", String(new Date().getTime()).slice(-6));
    client.test("S1 admin logged in", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### R1 Re-login admin ONLY when you get 401 (keeps the same suffix)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set("adminToken", response.body.data.accessToken);
    client.test("R1 admin re-logged in", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### S2a Class A: will hold the student (EXPECT 200)
POST {{host}}/api/class
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ib2ClassA{{sfx}}",
  "academicYear": "2026"
}

> {%
    client.global.set("classAId", response.body.data.id);
    client.test("S2a class A created", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

### S2b Class B: stays EMPTY (EXPECT 200)
POST {{host}}/api/class
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Ib2ClassB{{sfx}}",
  "academicYear": "2026"
}

> {%
    client.global.set("classBId", response.body.data.id);
    client.test("S2b class B created", function () {
        client.assert(response.status === 200, "status " + response.status);
    });
%}

